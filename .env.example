# Copy to .env and fill in. Never commit .env.

# Database (docker compose default)
DATABASE_URL=postgresql+asyncpg://tri:tri@localhost:5432/tri_mesure

# LLM provider: rules | anthropic | openai_compat
LLM_PROVIDER=rules
# Claude model id (anthropic provider). The evaluation page compares models;
# choose the default from the measured accuracy-per-euro numbers.
LLM_MODEL=claude-opus-5-5

# Anthropic (Claude) — https://platform.claude.com
ANTHROPIC_API_KEY=

# OpenAI-compatible provider (Groq free tier by default; also Mistral, Ollama, Azure OpenAI)
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama-3.1-8b-instant

# Hard daily spending cap for model calls, in euros
DAILY_BUDGET_EUR=2.0

# USD -> EUR rate used for the cost ledger (an assumption, shown in the UI)
USD_TO_EUR=0.92

# Raw e-mail bodies older than this are purged (masked copies are kept)
RAW_RETENTION_DAYS=30

# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173

# dev | prod — in prod the API refuses to start with the default signing secret
ENVIRONMENT=dev
# Secret used to sign demo-login tokens (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
AUTH_SECRET=
TOKEN_TTL_MINUTES=480

# Background AI analysis worker (runs inside the API process)
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1.0
WORKER_MAX_ATTEMPTS=3
